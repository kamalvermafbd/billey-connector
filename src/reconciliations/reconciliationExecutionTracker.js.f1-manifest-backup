
"use strict";

const { randomUUID } = require("crypto");

const {
    getTallyTransportUncertainty
} = require("../tally/tallyRequestQueue");

const UUID =
    /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

// Unique to this process lifetime. Never treat as a durable connector epoch.
const processEpoch = randomUUID();
const executions = new Map();
let fence = null;
let generation = 0;

function validateIdentity(identity) {
    if (
        !identity ||
        typeof identity !== "object" ||
        Array.isArray(identity) ||
        !["requestId", "attemptId", "executionId", "operationId"]
            .every(key =>
                typeof identity[key] === "string" &&
                UUID.test(identity[key])
            ) ||
        !Number.isSafeInteger(identity.operationOrdinal) ||
        identity.operationOrdinal <= 0
    ) {
        throw new Error("RECONCILE_TRACKER_IDENTITY_INVALID");
    }
}

function keyOf(identity) {
    return identity.requestId.toLowerCase();
}

function snapshot() {
    const records = [...executions.values()];

    return Object.freeze({
        processEpoch,
        generation,
        fenced: fence !== null,
        fenceId: fence?.fenceId ?? null,
        pending: records.filter(
            record => record.state === "QUEUED"
        ).length,
        running: records.filter(
            record => record.state === "RUNNING"
        ).length,

             // Local observation only; not durable recovery evidence.
        transportOutcomeKnown:
            getTallyTransportUncertainty() === null,

        drained:
            getTallyTransportUncertainty() === null &&
            records.every(
                record => record.state === "SETTLED"
            )
    });
}
// Observe only an execution registered in this process.
// Unknown identities must never be treated as drained.
function getReconciliationExecutionObservation({
    attemptId,
    executionId
} = {}) {
    if (
        typeof attemptId !== "string" ||
        !UUID.test(attemptId) ||
        typeof executionId !== "string" ||
        !UUID.test(executionId)
    ) {
        throw new Error(
            "RECONCILE_OBSERVATION_IDENTITY_INVALID"
        );
    }

    const matching = [...executions.values()].filter(
        record =>
            record.identity.attemptId.toLowerCase() ===
                attemptId.toLowerCase() &&
            record.identity.executionId.toLowerCase() ===
                executionId.toLowerCase()
    );

    const current = snapshot();

    return Object.freeze({
        attemptId,
        executionId,
        processEpoch,
        generation: current.generation,
        fenced: current.fenced,
        fenceId: current.fenceId,
        executionKnown: matching.length > 0,
        pending: matching.filter(
            record => record.state === "QUEUED"
        ).length,
        running: matching.filter(
            record => record.state === "RUNNING"
        ).length,
        settled: matching.filter(
            record => record.state === "SETTLED"
        ).length,

              // Callback completion is not remote settlement proof.
        // A response-less transport failure remains uncertain.
        transportOutcomeKnown:
            getTallyTransportUncertainty() === null,

        locallyDrained:
            getTallyTransportUncertainty() === null &&
            current.fenced === true &&
            fence !== null &&
            fence.attemptId.toLowerCase() ===
                attemptId.toLowerCase() &&
            fence.executionId.toLowerCase() ===
                executionId.toLowerCase() &&
            matching.length > 0 &&
            matching.every(
                record => record.state === "SETTLED"
            ),

        settlementEligible: false
    });
}
function admit(identity) {
    validateIdentity(identity);

    if (fence !== null) {
        throw new Error("RECONCILE_EXECUTION_FENCED");
    }

    const key = keyOf(identity);

    if (executions.has(key)) {
        throw new Error("RECONCILE_EXECUTION_DUPLICATE_REQUEST");
    }

    // Allow distinct operations within the same execution.
    // Preserve rejection of conflicting attempts and replayed operations.
    for (const record of executions.values()) {
        const existing = record.identity;

        if (
            existing.executionId.toLowerCase() !==
            identity.executionId.toLowerCase()
        ) {
            continue;
        }

        if (
            existing.attemptId.toLowerCase() !==
            identity.attemptId.toLowerCase()
        ) {
            throw new Error(
                "RECONCILE_EXECUTION_DUPLICATE_IDENTITY"
            );
        }

        if (
            existing.operationId.toLowerCase() ===
                identity.operationId.toLowerCase() ||
            existing.operationOrdinal ===
                identity.operationOrdinal
        ) {
            throw new Error(
                "RECONCILE_EXECUTION_DUPLICATE_OPERATION"
            );
        }
    }

    const record = {
        identity: Object.freeze({
            requestId: identity.requestId,
            attemptId: identity.attemptId,
            executionId: identity.executionId,
            operationId: identity.operationId,
            operationOrdinal: identity.operationOrdinal
        }),
        state: "QUEUED"
    };

    executions.set(key, record);
    generation++;

    let started = false;
    let settled = false;

    return Object.freeze({
        identity: record.identity,
        processEpoch,

        assertMayStart() {
            if (
                settled ||
                started ||
                record.state !== "QUEUED"
            ) {
                throw new Error(
                    "RECONCILE_EXECUTION_START_INVALID"
                );
            }

            if (fence !== null) {
                throw new Error("RECONCILE_EXECUTION_FENCED");
            }

            started = true;
            record.state = "RUNNING";
            generation++;
        },

        assertNotFenced() {
            if (settled || fence !== null) {
                throw new Error("RECONCILE_EXECUTION_FENCED");
            }
        },

        settle() {
            if (settled) return;

            settled = true;
            record.state = "SETTLED";
            generation++;

            // Retain settled identities for this process
            // lifetime to reject replay.
        }
    });
}

function installFence({
    fenceId,
    attemptId,
    executionId
} = {}) {
    if (
        typeof fenceId !== "string" ||
        !UUID.test(fenceId) ||
        typeof attemptId !== "string" ||
        !UUID.test(attemptId) ||
        typeof executionId !== "string" ||
        !UUID.test(executionId)
    ) {
        throw new Error("RECONCILE_FENCE_IDENTITY_INVALID");
    }

    if (
        fence !== null &&
        (
            fence.fenceId.toLowerCase() !== fenceId.toLowerCase() ||
            fence.attemptId.toLowerCase() !== attemptId.toLowerCase() ||
            fence.executionId.toLowerCase() !== executionId.toLowerCase()
        )
    ) {
        throw new Error("RECONCILE_FENCE_CONFLICT");
    }

    const matching = [...executions.values()].filter(
        record =>
            record.identity.attemptId.toLowerCase() ===
                attemptId.toLowerCase() &&
            record.identity.executionId.toLowerCase() ===
                executionId.toLowerCase()
    );

    const executionKnown = matching.length > 0;

    const identityConflict = [...executions.values()].some(
        record =>
            (
                record.identity.attemptId.toLowerCase() ===
                    attemptId.toLowerCase() ||
                record.identity.executionId.toLowerCase() ===
                    executionId.toLowerCase()
            ) &&
            !matching.includes(record)
    );

    if (fence === null) {
        fence = Object.freeze({
            fenceId,
            attemptId,
            executionId
        });
        generation++;
    }

    return Object.freeze({
        ...snapshot(),
        executionKnown,
        identityConflict,
        settlementEligible: false
    });
}
module.exports = {
    admitReconciliationExecution: admit,
    installReconciliationFence: installFence,
    getReconciliationExecutionSnapshot: snapshot,
    getReconciliationExecutionObservation
};

